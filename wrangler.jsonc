{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rollndoor",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // A Worker csak ezekre fut elsőként; minden más közvetlenül statikus fájl.
    "run_worker_first": ["/api/*", "/r/*", "/m/*", "/le/*", "/dashboard", "/dashboard/*", "/pult", "/pult/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rollndoor",
      // Az éles adatbázis azonosítója (`wrangler d1 create rollndoor` kimenete). Nem titok.
      "database_id": "c88cba75-fe72-4faf-8073-aa187189d4fd"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "rollndoor-files" }
  ],
  // 2. kor: napi cron (UTC 07:00): ajánlat-emlékeztetők és szerelés előtti napi levél (worker/src/cron.ts)
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "vars": {
    "RICSI_EMAIL": "info@rollndoor.hu",
    "REPLY_DOMAIN": "valasz.rollndoor.hu",
    // ÁTMENETI (próbaüzem): a levelek linkjei a workers.dev címre mutatnak. A domain átállításakor VISSZA: "https://rollndoor.hu"
    "SITE_URL": "https://rollndoor.poczaizoltan30.workers.dev",
    // ÁTMENETI: a /dashboard belépés nélkül nyitott, mert még csak próbaadat van. ÉLESÍTÉS ELŐTT TÖRÖLNI (különben bárki látja az ügyfeleket és a /m/ linkjeiket).
    "DASHBOARD_NYILT": "1"
  }
}
